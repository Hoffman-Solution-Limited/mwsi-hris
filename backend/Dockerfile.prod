# -------------------------
# Stage 1: Build
# -------------------------
FROM node:20-alpine AS builder

WORKDIR /usr/src/app

# Copy package files and install dependencies
COPY backend/package*.json ./
RUN npm install

# Copy backend source
COPY backend/ ./

# Build backend (TS → JS or whatever your build step is)
RUN npm run build

# -------------------------
# Stage 2: Production
# -------------------------
FROM node:20-alpine

WORKDIR /usr/src/app

# Copy package files and install only production dependencies
COPY backend/package*.json ./
RUN npm install --omit=dev

# Copy built backend and scripts
COPY --from=builder /usr/src/app/dist ./dist
COPY --from=builder /usr/src/app/scripts ./scripts

# Set environment
ENV PORT=8000
EXPOSE 8000

# Run DB wait + schema/seed + app in a single command
CMD sh -c "\
  echo 'Waiting for DB...' && \
  until node -e 'require(\"pg\").Pool({connectionString: process.env.DATABASE_URL}).connect().then(c=>c.release()).catch(()=>process.exit(1))'; do \
    echo 'DB not ready, retrying in 2s...' && sleep 2; \
  done && \
  echo 'DB ready! Running seed...' && \
  node ./scripts/seed.js && \
  echo 'Starting app...' && \
  node dist/index.js \
"
