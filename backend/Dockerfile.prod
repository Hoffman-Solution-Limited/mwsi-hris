# -------------------------
# Stage 1: Builder
# -------------------------
FROM node:20-alpine AS builder

WORKDIR /usr/src/app

# Copy backend package files
COPY backend/package*.json ./

# Install dev + prod dependencies
RUN npm install

# Copy all backend source
COPY backend/ ./

# Build the project (TS → JS)
RUN npm run build

# -------------------------
# Stage 2: Production
# -------------------------
FROM node:20-alpine

WORKDIR /usr/src/app

# Copy only package.json & package-lock.json for production deps
COPY backend/package*.json ./

# Install only production dependencies
RUN npm install --omit=dev

# Copy built files from builder
COPY --from=builder /usr/src/app/dist ./dist
COPY --from=builder /usr/src/app/scripts ./scripts

ENV PORT=5000
EXPOSE 5000

# Run DB wait, seed, then start app
CMD sh -c "\
  echo 'Waiting for DB...' && \
  until node -e 'const { Pool } = require(\"pg\"); new Pool({ connectionString: process.env.DATABASE_URL }).connect().then(c => c.release())'; do \
    echo 'DB not ready, retrying in 2s...' && sleep 2; \
  done && \
  echo 'DB ready! Running seed...' && \
  node ./scripts/seed.js && \
  echo 'Starting app...' && \
  node dist/index.js \
"
