# Stage 1: Build
FROM node:20-alpine AS builder

WORKDIR /usr/src/app

# Copy package files first for caching
COPY backend/package*.json ./
RUN npm ci

# Copy backend source
COPY backend/ ./

# Copy database files
COPY database/generated/ ./database/generated/

# Build the project
RUN npm run build

# Stage 2: Production
FROM node:20-alpine

WORKDIR /usr/src/app

# Copy production dependencies
COPY backend/package*.json ./
RUN npm ci --only=production

# Copy built files
COPY --from=builder /usr/src/app/dist ./dist

# Copy database files for seeding
COPY database/generated/ ./database/generated/

# Expose your port
EXPOSE 8000

# Start backend
CMD ["node", "dist/index.js"]
